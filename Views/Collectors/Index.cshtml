@model List<CollectorMapEntry>
@{
    ViewData["Title"] = "Mapa de Coleccionistas";
}

@functions {
    static (double cx, double cy) PinPosition(string userId)
    {
        // Deterministic position within the Ecuador SVG region
        // based on user ID hash so the same user always gets the same spot
        var hash = Math.Abs(userId.GetHashCode());
        var cx = 205 + (hash % 60);
        var cy = 155 + ((hash / 60) % 50);
        return (cx, cy);
    }

    static string PinColor(int index) => index switch
    {
        0 => "#5B2C9E",
        1 => "#FF6B6B",
        2 => "#3B6D11",
        3 => "#06B6D4",
        _ => "#FFD23F"
    };

    static string Initials(string displayName)
    {
        var parts = displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant()
            : displayName.Substring(0, Math.Min(2, displayName.Length)).ToUpperInvariant();
    }
}

<div class="d-flex justify-content-between align-items-start mb-2 flex-wrap gap-2">
    <div>
        <h1 class="mb-1">MAPA DE COLECCIONISTAS</h1>
        <p class="px-font mb-0" style="font-size:0.85rem; color:var(--gv-muted)">
            &#9733; Comunidad GameVault en Latinoamérica
        </p>
    </div>
    <span class="px-badge px-badge-yellow">&#128205; QUITO, ECUADOR</span>
</div>

<div class="row mt-4 g-4">
    <div class="col-lg-7">
        <div class="px-card p-3" style="background:var(--gv-yellow-soft); min-height:420px">
            <svg viewBox="0 0 400 500" style="width:100%; height:auto; display:block">
                <defs>
                    <style>
                        .map-land { fill: #C0DD97; stroke: #1A1A2E; stroke-width: 1.5; }
                        .map-ocean { fill: #B5D4F4; }
                        .map-border { stroke: #1A1A2E; stroke-width: 0.5; fill: none; }
                        .pin-label { font-family: 'Courier New', monospace; font-size: 9px; font-weight: 800; fill: #1A1A2E; }
                    </style>
                </defs>

                <rect width="400" height="500" class="map-ocean" rx="4"/>

                <path class="map-land" d="M180,30 L230,25 L270,40 L280,70 L275,100 L265,130
                    L270,160 L260,200 L250,240 L255,280 L245,320 L230,360
                    L220,400 L210,440 L200,470 L190,440 L185,400 L175,360
                    L165,320 L160,280 L165,240 L155,200 L150,160 L155,130
                    L145,100 L140,70 L150,40 Z"/>

                <path class="map-land" d="M120,180 L155,165 L160,200 L155,220 L130,230 L105,220 L100,195 Z"/>
                <path class="map-land" d="M265,130 L300,120 L330,140 L335,175 L310,185 L280,170 L270,150 Z"/>
                <path class="map-land" d="M155,300 L140,280 L115,295 L110,330 L130,350 L160,345 Z"/>
                <path class="map-land" d="M255,290 L280,285 L305,300 L300,335 L275,340 L250,330 Z"/>

                <line x1="145" y1="100" x2="155" y2="130" class="map-border"/>
                <line x1="265" y1="130" x2="270" y2="160" class="map-border"/>

                @{
                    int pinIdx = 0;
                    foreach (var entry in Model)
                    {
                        var (cx, cy) = PinPosition(entry.User.Id);
                        var color = PinColor(pinIdx);
                        var initials = Initials(entry.User.DisplayName);
                        var locationLabel = entry.User.City ?? entry.User.Country ?? "?";
                        <g class="collector-pin" style="cursor:pointer">
                            <circle cx="@cx" cy="@cy" r="14" fill="@color" stroke="#1A1A2E" stroke-width="2"/>
                            <text x="@cx" y="@(cy + 4)" text-anchor="middle" class="pin-label" fill="white">@initials</text>
                            <circle cx="@cx" cy="@(cy + 16)" r="2" fill="@color" stroke="#1A1A2E" stroke-width="1"/>
                            <text x="@(cx + 18)" y="@(cy - 6)" class="pin-label" fill="@color">@entry.User.DisplayName</text>
                            <text x="@(cx + 18)" y="@(cy + 5)" class="pin-label" fill="#6B6B7B">@locationLabel · @entry.ActiveAssetCount activos</text>
                        </g>
                        pinIdx++;
                    }
                }

                <text x="12" y="490" font-family="'Courier New', monospace" font-size="9"
                      fill="#6B6B7B">★ GAMEVAULT · MAPA COMUNITARIO</text>
            </svg>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="px-card p-3 mb-3" style="background:var(--gv-yellow-soft)">
            <p class="px-section-title mb-2">CERCA DE TI &middot; @Model.Count</p>
            <div class="d-flex gap-2 flex-wrap">
                <span class="px-badge px-badge-yellow">DISTANCIA &#9660;</span>
                <span class="px-badge px-badge-purple">NES</span>
                <span class="px-badge px-badge-cyan">SNES</span>
                <span class="px-badge px-badge-green">N64</span>
                <span class="px-badge px-badge-coral">PS1</span>
            </div>
        </div>

        <div class="d-flex flex-column gap-3">
            @{
                int sideIdx = 0;
                foreach (var entry in Model)
                {
                    var color = PinColor(sideIdx);
                    var initials = Initials(entry.User.DisplayName);
                    var location = string.Join(", ",
                        new[] { entry.User.City, entry.User.Country }
                            .Where(s => !string.IsNullOrWhiteSpace(s)));
                    <div class="px-card p-3 d-flex align-items-center gap-3">
                        <div class="flex-shrink-0 d-flex align-items-center justify-content-center px-font fw-bold"
                             style="width:44px; height:44px; background:@color; color:#fff; border:2px solid var(--gv-ink); font-size:0.85rem">
                            @initials
                        </div>
                        <div class="flex-grow-1 overflow-hidden">
                            <p class="px-font fw-bold mb-0 text-truncate" style="font-size:0.9rem">
                                <a asp-controller="Users" asp-action="Profile"
                                   asp-route-id="@entry.User.Id"
                                   class="text-decoration-none" style="color:var(--gv-ink)">
                                    @entry.User.DisplayName
                                </a>
                            </p>
                            @if (!string.IsNullOrWhiteSpace(location))
                            {
                                <p class="mb-0 px-font" style="font-size:0.75rem; color:var(--gv-muted)">
                                    &#128205; @location
                                </p>
                            }
                            <div class="d-flex gap-1 flex-wrap mt-1">
                                <span class="px-badge px-badge-yellow">@entry.ActiveAssetCount activos</span>
                                @foreach (var p in entry.TopPlatforms)
                                {
                                    <span class="px-badge" style="background:#fff; color:var(--gv-ink)">
                                        @p.GetDisplayName()
                                    </span>
                                }
                            </div>
                        </div>
                        <a asp-controller="Users" asp-action="Profile"
                           asp-route-id="@entry.User.Id"
                           class="px-btn px-btn-secondary px-btn-sm flex-shrink-0">VER</a>
                    </div>
                    sideIdx++;
                }
            }
        </div>
    </div>
</div>
